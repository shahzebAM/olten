generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                     Int          @id @default(autoincrement())
  firstName              String
  middleName             String?
  lastName               String
  dateOfBirth            DateTime
  address                String
  civilStatus            String
  baseRate               Float
  employmentStatus       String
  tin                    String?      @unique
  sssNumber              String?      @unique
  philhealth             String?      @unique
  pagIbig                String?      @unique
  bankAccount            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @default(now()) @updatedAt
  cashAdvanceBalance     Float        @default(0)
  cashAdvanceInstallment Float        @default(0)
  company                String       @default("Olten")
  attendances            Attendance[]
  payrolls               Payroll[]
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  role     String @default("Super Admin")
  modules  Json?
  status   String @default("Active")
}

model Settings {
  id         Int    @id @default(autoincrement())
  company    String @unique @default("Global") 
  shiftStart String @default("08:00")
  shiftEnd   String @default("17:00")
}

model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       String
  timeIn     String
  timeOut    String
  hours      Float
  reason     String?
  shiftStart String?
  shiftEnd   String?
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Payroll {
  id                 Int      @id @default(autoincrement())
  employeeId         Int
  daysWorked         Float
  totalHours         Float
  cashAdvance        Float    @default(0)
  sssDeduction       Float    @default(0)
  pagIbigDeduct      Float    @default(0)
  philhealthDeduct   Float    @default(0)
  tax                Float    @default(0)
  grossPay           Float
  netPay             Float
  createdAt          DateTime @default(now())
  pagIbigHousingLoan Float    @default(0)
  pagIbigLoan        Float    @default(0)
  pagIbigCalamity    Float    @default(0)
  pagIbigSalaryLoan  Float    @default(0)
  sssCalamityLoan    Float    @default(0)
  sssProvident       Float    @default(0)
  sssSalaryLoan      Float    @default(0)
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Document {
  id              Int      @id @default(autoincrement())
  filename        String
  originalName    String
  mimeType        String
  sizeBytes       Int
  company         String
  geminiFileUri   String?
  geminiFileId    String?
  status          String   @default("PROCESSING")
  uploadedBy      String
  createdAt       DateTime @default(now())
  googleDriveLink String?

  @@index([company])
}

model SearchHistory {
  id               Int      @id @default(autoincrement())
  username         String
  company          String
  query            String
  response         String
  modelUsed        String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  createdAt        DateTime @default(now())
}

model Product {
  id            Int       @id @default(autoincrement())
  company       String
  name          String
  sku           String
  category      String
  purchasePrice Float
  sellingPrice  Float
  minQuantity   Int       @default(10)
  reorderLevel  Int       @default(20)
  unit          String
  isActive      Boolean   @default(true)
  vatSetting    String
  imageUrl      String?
  barcode       String?
  currentStock  Int       @default(0)
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  @@index([company])
  @@index([sku])
}

model InventoryMovement {
  id            String   @id @default(uuid())
  productId     Int
  productName   String
  sku           String
  type          String   // 'RECEIVE' | 'ISSUE' | 'ADJUST'
  quantity      Int
  previousStock Int
  newStock      Int
  reference     String?
  remarks       String?
  date          DateTime @default(now())
  user          String
  company       String
}

model Warehouse {
  id          String   @id @default(uuid())
  company     String
  name        String
  location    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model WarehouseStock {
  id          String   @id @default(uuid())
  warehouseId String
  productId   Int
  sku         String
  quantity    Int      @default(0)
  company     String
  lastUpdated DateTime @default(now())

  @@unique([warehouseId, productId])
}

model WarehouseTransfer {
  id              String   @id @default(uuid())
  sourceId        String
  destinationId   String
  productId       Int
  sku             String
  quantity        Int
  transferDate    DateTime @default(now())
  reference       String?
  user            String
  company         String
}

model Supplier {
  id        String   @id @default(uuid())
  company   String
  name      String
  contact   String?
  phone     String?
  email     String?
  balance   Float    @default(0) 
  isActive  Boolean  @default(true)
  pos       PurchaseOrder[]
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  company     String
  poNumber    String
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  date        DateTime @default(now())
  status      String   @default("PENDING") // PENDING, APPROVED, RECEIVED, CANCELLED
  totalAmount Float    @default(0)
  items       PurchaseOrderItem[]
  user        String
}

model PurchaseOrderItem {
  id          String @id @default(uuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId   Int
  sku         String
  productName String
  quantity    Int
  unitPrice   Float
  total       Float
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Customer {
  id          String   @id @default(uuid())
  company     String
  name        String
  contact     String?
  phone       String?
  email       String?
  address     String?
  creditLimit Float    @default(0)
  balance     Float    @default(0) // Tracks Outstanding Receivables
  createdAt   DateTime @default(now())
}

model SalesOrder {
  id          String   @id @default(uuid())
  company     String
  soNumber    String
  customerId  String
  date        DateTime @default(now())
  status      String   @default("PENDING") // PENDING, APPROVED, FULFILLED, RETURNED
  totalAmount Float
  items       Json
  user        String
}