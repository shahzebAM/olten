generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                     Int          @id @default(autoincrement())
  firstName              String
  middleName             String?
  lastName               String
  dateOfBirth            DateTime
  address                String
  civilStatus            String
  baseRate               Float
  employmentStatus       String
  tin                    String?      @unique
  sssNumber              String?      @unique
  philhealth             String?      @unique
  pagIbig                String?      @unique
  bankAccount            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @default(now()) @updatedAt
  cashAdvanceBalance     Float        @default(0)
  cashAdvanceInstallment Float        @default(0)
  company                String       @default("Olten")
  attendances            Attendance[]
  payrolls               Payroll[]
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  role     String @default("Super Admin")
  modules  Json?
  status   String @default("Active")
}

model Settings {
  id         Int    @id @default(autoincrement())
  shiftStart String @default("08:00")
  shiftEnd   String @default("17:00")
}

model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       String
  timeIn     String
  timeOut    String
  hours      Float
  reason     String?
  shiftStart String?
  shiftEnd   String?
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Payroll {
  id                 Int      @id @default(autoincrement())
  employeeId         Int
  daysWorked         Float
  totalHours         Float
  cashAdvance        Float    @default(0)
  sssDeduction       Float    @default(0)
  pagIbigDeduct      Float    @default(0)
  philhealthDeduct   Float    @default(0)
  tax                Float    @default(0)
  grossPay           Float
  netPay             Float
  createdAt          DateTime @default(now())
  pagIbigHousingLoan Float    @default(0)
  pagIbigLoan        Float    @default(0)
  pagIbigCalamity    Float    @default(0)
  pagIbigSalaryLoan  Float    @default(0)
  sssCalamityLoan    Float    @default(0)
  sssProvident       Float    @default(0)
  sssSalaryLoan      Float    @default(0)
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Document {
  id              Int      @id @default(autoincrement())
  filename        String
  originalName    String
  mimeType        String
  sizeBytes       Int
  company         String
  geminiFileUri   String?
  geminiFileId    String?
  status          String   @default("PROCESSING")
  uploadedBy      String
  createdAt       DateTime @default(now())
  googleDriveLink String?

  @@index([company])
}

model SearchHistory {
  id               Int      @id @default(autoincrement())
  username         String
  company          String
  query            String
  response         String
  modelUsed        String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  createdAt        DateTime @default(now())
}

model Product {
  id            Int       @id @default(autoincrement())
  company       String
  name          String
  sku           String
  category      String
  purchasePrice Float
  sellingPrice  Float
  minQuantity   Int       @default(10)
  reorderLevel  Int       @default(20)
  unit          String
  isActive      Boolean   @default(true)
  vatSetting    String
  imageUrl      String?
  barcode       String?
  currentStock  Int       @default(0)
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  @@index([company])
  @@index([sku])
}

model InventoryMovement {
  id            String   @id @default(uuid())
  productId     Int
  productName   String
  sku           String
  type          String   // 'RECEIVE' | 'ISSUE' | 'ADJUST'
  quantity      Int
  previousStock Int
  newStock      Int
  reference     String?
  remarks       String?
  date          DateTime @default(now())
  user          String
  company       String
}
